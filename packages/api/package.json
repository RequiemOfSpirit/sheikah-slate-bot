{
  "name": "@sheikah-slate-bot/api",
  "version": "0.0.0",
  "description": "API server that provides basic CRUDL for Sheikah Slate Resources",
  "scripts": {
    "clean:dist": "rm -rf dist",
    "clean": "npm run clean:dist && rm -rf node_modules",
    "lint:fix": "eslint --fix --cache --cache-location ./node_modules/.cache/.eslintcache/ --report-unused-disable-directives --max-warnings 0 && prettier --cache -w .",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run lint:fix",
    "build": "npm run dist",
    "predist": "npm run clean:dist",
    "dist": "tsc",
    "start": "node dist/server.js"
  },
  "type": "module",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.48.4",
    "@fastify/postgres": "^6.0.2",
    "@fastify/type-provider-typebox": "^6.0.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.16.3",
    "typebox": "^1.0.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.6.2",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
