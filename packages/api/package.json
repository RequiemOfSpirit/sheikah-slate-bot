{
  "name": "@sheikah-slate-bot/api",
  "version": "0.0.0",
  "description": "API server that provides basic CRUDL for Sheikah Slate Resources",
  "exports": {
    ".": {
      "import": "./build/dist/app.js",
      "types": "./build/dist/app.d.ts"
    },
    "./client": {
      "import": "./build/dist/client/index.js",
      "types": "./build/dist/client/index.d.ts"
    },
    "./client-utils": {
      "import": "./build/dist/client/client/index.js",
      "types": "./build/dist/client/client/index.d.ts"
    }
  },
  "scripts": {
    "clean:build": "rm -rf build",
    "clean": "npm run clean:build && rm -rf node_modules",
    "lint:fix": "eslint --fix --cache --cache-location ./node_modules/.cache/.eslintcache/ --report-unused-disable-directives --max-warnings 0 && prettier --cache -w .",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run lint:fix",
    "build": "npm run dist",
    "predist": "npm run clean:build",
    "dist": "tsc",
    "postdist": "npm run spec:generate && npm run client:generate && npm run client:build",
    "spec:generate": "node scripts/generate-openapi-spec.js",
    "client:generate": "openapi-ts",
    "client:build": "tsc -p tsconfig.client.json",
    "start": "node build/dist/server.js"
  },
  "type": "module",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@fastify/postgres": "^6.0.2",
    "@fastify/swagger": "^9.5.2",
    "@fastify/type-provider-typebox": "^6.0.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.16.3",
    "typebox": "^1.0.30"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@hey-api/openapi-ts": "^0.85.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.5",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
