/* Base TSConfig settings for projects run in node environments */
{
  "extends": "./tsconfig.base.json",
  "exclude": ["${configDir}/build", "${configDir}/node_modules"],
  "compilerOptions": {
    /* Project */
    "tsBuildInfoFile": "${configDir}/build/.tsbuildinfo/tsconfig.tsbuildinfo",

    /* Module and Environment */
    "types": ["node"],
    "rootDir": "${configDir}/src",
    "rewriteRelativeImportExtensions": true,

    /* Output */
    "outDir": "${configDir}/build/dist",
    "removeComments": true,
  },
}
